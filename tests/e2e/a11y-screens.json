{
  "$comment": "Screens tests/e2e/a11y.spec.js checks with axe-core. This file belongs to the plugin: apply-template.py only writes it when it is missing. The fields are described in docs/DEVELOPMENT.md.",
  "include": ["#wpbody-content"],
  "exclude": [],
  "screens": [
    {
      "name": "Appearance > Page Template Usage, no pages yet",
      "url": "/wp-admin/themes.php?page=page-template-usage"
    },
    {
      "name": "Appearance > Page Template Usage with pages on a missing template",
      "setup": [
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=Home", "--porcelain"], "save": "home" },
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=About us", "--meta_input={\"_wp_page_template\":\"page-no-title\"}", "--porcelain"], "save": "about" },
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=Spring sale", "--meta_input={\"_wp_page_template\":\"templates/landing.php\"}", "--porcelain"], "save": "sale" }
      ],
      "url": "/wp-admin/themes.php?page=page-template-usage",
      "steps": [{ "waitFor": ".ptu-table" }],
      "cleanup": [["post", "delete", "{home}", "{about}", "{sale}", "--force"]]
    },
    {
      "name": "Pages list with the Template column, filter and missing-template notice",
      "setup": [
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=Home", "--porcelain"], "save": "home" },
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=About us", "--meta_input={\"_wp_page_template\":\"page-no-title\"}", "--porcelain"], "save": "about" },
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=Spring sale", "--meta_input={\"_wp_page_template\":\"templates/landing.php\"}", "--porcelain"], "save": "sale" }
      ],
      "url": "/wp-admin/edit.php?post_type=page",
      "steps": [{ "waitFor": ".ptu-missing-notice" }],
      "include": [".ptu-missing-notice", "#filter-by-template", ".column-page_template_usage"],
      "cleanup": [["post", "delete", "{home}", "{about}", "{sale}", "--force"]]
    },
    {
      "name": "Pages list filtered to pages on a missing template",
      "setup": [
        { "wp": ["post", "create", "--post_type=page", "--post_status=publish", "--post_title=Spring sale", "--meta_input={\"_wp_page_template\":\"templates/landing.php\"}", "--porcelain"], "save": "sale" }
      ],
      "url": "/wp-admin/edit.php?post_type=page&page_template_usage=__missing",
      "include": ["#filter-by-template", ".column-page_template_usage"],
      "cleanup": [["post", "delete", "{sale}", "--force"]]
    }
  ],
  "skip": {}
}
